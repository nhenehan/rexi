<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:rexi:interop:telemetry"
           xmlns="urn:rexi:interop:telemetry"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:element name="TelemetryBatch" type="TelemetryBatchType"/>

  <xs:complexType name="TelemetryBatchType">
    <xs:sequence>
      <xs:element name="Device" type="DeviceType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="site" type="xs:string" use="required"/>
    <xs:attribute name="generatedAt" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DeviceType">
    <xs:sequence>
      <xs:element name="Reading" type="ReadingType" maxOccurs="unbounded"/>
      <xs:element name="Alarm" type="AlarmType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Healthy" type="xs:boolean"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="model" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ReadingType">
    <xs:sequence>
      <xs:element name="Type" type="xs:string"/>
      <xs:element name="Value" type="xs:double"/>
      <xs:element name="Unit" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="sample" type="xs:int" use="required"/>
  </xs:complexType>

  <xs:complexType name="AlarmType">
    <xs:sequence>
      <xs:element name="Code" type="xs:string"/>
      <xs:element name="Severity" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
