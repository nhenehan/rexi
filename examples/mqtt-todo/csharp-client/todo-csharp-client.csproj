<!--
  todo-csharp-client: the MQTT todo example's C# client.
  MQTTnet (MQTT 3.1.1) + Nagasena for .NET (EXI), .NET 10.

    dotnet build -c Release -p:NagasenaCsDir=<cache>/nagasenacs -o ../build/csharp-client
    ../build/csharp-client/todo-csharp-client list | add TITLE | done ID | remove ID

  ../build.sh does this. todo.xsc is todo.xsd compiled by Java Nagasena
  (../scripts/gen-xsc.sh); it is copied next to the program.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>todo-csharp-client</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="OpenEXI.Nagasena.csproj" />
    <Reference Include="Sax">
      <HintPath>$(NagasenaCsDir)/lib/saxdotnet/Sax.dll</HintPath>
    </Reference>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <None Include="todo.xsc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
